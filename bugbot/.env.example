# ── Trello (read-only API key + token) ────────────────────────
# Generate at https://trello.com/power-ups/admin  →  API Key
# Then visit: https://trello.com/1/authorize?expiration=never&scope=read&response_type=token&key=YOUR_KEY
TRELLO_API_KEY=
TRELLO_TOKEN=

# Board name(s) to watch — comma-separated if multiple
TRELLO_BOARDS=My Project Board

# The list (column) name that holds the bug cards
TRELLO_LIST_NAME=Bugs

# ── GitHub (read-only personal access token) ──────────────────
# Create at https://github.com/settings/tokens
# Scopes needed: repo (read-only) — use a fine-grained token with read-only Contents permission
GITHUB_TOKEN=
GITHUB_ORG=

# ── Optional: post the report back as a Trello comment ────────
# Set to "true" to enable (requires read+write token above instead of read-only)
POST_COMMENT=false
